@page "/Error"
@using System.Diagnostics

<PageTitle>Fehler</PageTitle>

<h1 class="text-danger">Fehler.</h1>
<h2 class="text-danger">Bei der Verarbeitung deiner Anfrage ist ein Fehler aufgetreten.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>Anforderungs-ID:</strong> <code>@requestId</code>
    </p>
}

<h3>Entwicklungsmodus</h3>
<p>
    Der Wechsel zur Umgebung <strong>Development</strong> zeigt detailliertere Informationen über den aufgetretenen Fehler an.
</p>
<p>
    <strong>Die Umgebung „Development" sollte für bereitgestellte Anwendungen nicht aktiviert werden.</strong>
    Dies kann dazu führen, dass vertrauliche Informationen aus Ausnahmen den Endbenutzern angezeigt werden.
    Aktiviere die Umgebung <strong>Development</strong> für lokales Debugging, indem du die Umgebungsvariable <strong>ASPNETCORE_ENVIRONMENT</strong> auf <strong>Development</strong> setzt
    und die App neu startest.
</p>

@code{
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private string? requestId;
    private bool ShowRequestId => !string.IsNullOrEmpty(requestId);

    protected override void OnInitialized()
    {
        requestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
