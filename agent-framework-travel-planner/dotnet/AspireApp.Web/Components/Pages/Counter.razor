@page "/counter"
@rendermode InteractiveServer

<PageTitle>Zähler</PageTitle>

<h1>Zähler</h1>

<p role="status">Aktueller Stand: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Klick mich</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
